 def test_refund_twice_conflicts(client: TestClient, paid_invoice: dict) -> None:  # type: ignore[type-arg]
     client.post(f"/invoices/{paid_invoice['id']}/refund")
     assert client.post(f"/invoices/{paid_invoice['id']}/refund").status_code == 409
+
+
+def test_seed_on_startup(monkeypatch) -> None:  # type: ignore[no-untyped-def]
+    from ledgerly.api.app import create_app
+    from ledgerly.services.store import open_store
+
+    monkeypatch.setenv("LEDGERLY_SEED", "1")
+    with TestClient(create_app(open_store())) as c:
+        assert len(c.get("/invoices").json()) == 2
