+def _hundred_invoice(client: TestClient) -> dict:  # type: ignore[type-arg]
+    return client.post(
+        "/invoices",
+        json={
+            "customer": "Acme",
+            "currency": "USD",
+            "lines": [{"description": "Plan", "quantity": 1, "unit_cents": 10_000}],
+            "vat_rate_bp": 0,
+        },
+    ).json()
+
+
+def test_installments_split_invoice_total(client: TestClient) -> None:
+    invoice = _hundred_invoice(client)
+    resp = client.get(f"/invoices/{invoice['id']}/installments", params={"count": 3})
+    assert resp.status_code == 200
+    assert resp.json() == {
+        "invoice_id": invoice["id"],
+        "count": 3,
+        "installments": [
+            {"amount_cents": 3_333, "currency": "USD"},
+            {"amount_cents": 3_333, "currency": "USD"},
+            {"amount_cents": 3_334, "currency": "USD"},
+        ],
+    }
+
+
+def test_installments_unknown_invoice_not_found(client: TestClient) -> None:
+    assert client.get("/invoices/999/installments", params={"count": 3}).status_code == 404
+
+
