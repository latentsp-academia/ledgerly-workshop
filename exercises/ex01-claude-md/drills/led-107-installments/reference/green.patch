diff --git a/src/ledgerly/services/installments.py b/src/ledgerly/services/installments.py
new file mode 100644
index 0000000..d69cb2d
--- /dev/null
+++ b/src/ledgerly/services/installments.py
@@ -0,0 +1,37 @@
+"""Installment plans: split an invoice total into equal payments.
+
+Rounding rule (CLAUDE.md, Money): every part is ``total // count`` cents and the last part
+absorbs the remainder, so the parts always sum to the total. Finance reconciles on this.
+"""
+
+from __future__ import annotations
+
+import sqlite3
+from dataclasses import dataclass
+
+from ledgerly.payments.money import Money
+from ledgerly.services.invoices import get_invoice
+
+
+@dataclass(frozen=True, slots=True, kw_only=True)
+class InstallmentPlan:
+    invoice_id: int
+    count: int
+    installments: tuple[Money, ...]
+
+
+def split(total: Money, count: int) -> tuple[Money, ...]:
+    if count < 1:
+        raise ValueError("Installment count must be at least 1")
+    base = total.cents // count
+    head = (Money(base, total.currency),) * (count - 1)
+    return (*head, Money(total.cents - base * (count - 1), total.currency))
+
+
+def installment_plan(conn: sqlite3.Connection, invoice_id: int, count: int) -> InstallmentPlan:
+    invoice = get_invoice(conn, invoice_id)
+    return InstallmentPlan(
+        invoice_id=invoice.id,
+        count=count,
+        installments=split(invoice.total, count),
+    )
