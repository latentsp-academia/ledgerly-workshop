diff --git a/src/ledgerly/api/app.py b/src/ledgerly/api/app.py
index f67727e..7e65b34 100644
--- a/src/ledgerly/api/app.py
+++ b/src/ledgerly/api/app.py
@@ -1,10 +1,13 @@
 from __future__ import annotations
 
+import os
 import sqlite3
 
 from fastapi import FastAPI
 
 from ledgerly.api import routes_invoices, routes_refunds
+from ledgerly.payments.money import Money
+from ledgerly.services import invoices as invoice_svc
 from ledgerly.services.store import open_store
 
 
@@ -14,6 +17,19 @@ def create_app(conn: sqlite3.Connection | None = None) -> FastAPI:
     app.include_router(routes_invoices.router)
     app.include_router(routes_refunds.router)
 
+    @app.on_event("startup")
+    def seed_demo_data() -> None:
+        if os.environ.get("LEDGERLY_SEED") != "1":
+            return
+        conn = app.state.conn
+        demo = invoice_svc.create_invoice(
+            conn, "Demo Co", "USD", [invoice_svc.Line("Demo", 1, Money(10_000, "USD"))]
+        )
+        invoice_svc.capture(conn, demo.id)
+        invoice_svc.create_invoice(
+            conn, "Sample GmbH", "EUR", [invoice_svc.Line("Sample", 1, Money(5_000, "EUR"))]
+        )
+
     @app.get("/health")
     def health() -> dict[str, str]:
         return {"status": "ok"}
diff --git a/tests/test_api.py b/tests/test_api.py
index 3a99850..68714d3 100644
--- a/tests/test_api.py
+++ b/tests/test_api.py
@@ -36,3 +36,12 @@ def test_full_refund(client: TestClient, paid_invoice: dict) -> None:  # type: i
 def test_refund_twice_conflicts(client: TestClient, paid_invoice: dict) -> None:  # type: ignore[type-arg]
     client.post(f"/invoices/{paid_invoice['id']}/refund")
     assert client.post(f"/invoices/{paid_invoice['id']}/refund").status_code == 409
+
+
+def test_seed_on_startup(monkeypatch) -> None:  # type: ignore[no-untyped-def]
+    from ledgerly.api.app import create_app
+    from ledgerly.services.store import open_store
+
+    monkeypatch.setenv("LEDGERLY_SEED", "1")
+    with TestClient(create_app(open_store())) as c:
+        assert len(c.get("/invoices").json()) == 2
