+def test_installments_split_total_exactly(client: TestClient) -> None:
+    created = client.post(
+        "/invoices",
+        json={
+            "customer": "Acme",
+            "currency": "USD",
+            "lines": [{"description": "Widget", "quantity": 1, "unit_cents": 8_547}],
+        },
+    ).json()
+    assert created["total_cents"] == 10_000
+    resp = client.get(f"/invoices/{created['id']}/installments", params={"count": 3})
+    assert resp.status_code == 200
+    assert resp.json() == {
+        "invoice_id": created["id"],
+        "count": 3,
+        "installments": [3_334, 3_333, 3_333],
+    }
+
+
+def test_installments_rejects_bad_count(client: TestClient, paid_invoice: dict) -> None:  # type: ignore[type-arg]
+    url = f"/invoices/{paid_invoice['id']}/installments"
+    assert client.get(url, params={"count": 0}).status_code == 422
+    assert client.get(url, params={"count": 10**9}).status_code == 400
+
