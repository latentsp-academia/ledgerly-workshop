{
 "title": "Stop finish line: gates, attempts, the stop rule",
 "reset_state": [
  ".claude/state/finish_line.json"
 ],
 "cases": [
  {
   "name": "No code changed: a question isn't gated",
   "hook": "finish_line.py",
   "event": {
    "hook_event_name": "Stop",
    "stop_hook_active": false
   },
   "expect": "pass",
   "session": "q"
  },
  {
   "name": "Red gate: block (attempt 1/3)",
   "hook": "finish_line.py",
   "files": {
    "src/ledgerly/_hooktest_red.py": "def f() -> int:\n    try:\n        return 1\n    except:\n        return 2\n"
   },
   "cleanup": false,
   "event": {
    "hook_event_name": "Stop",
    "stop_hook_active": false
   },
   "expect": "block",
   "session": "red"
  },
  {
   "name": "Still red: block (attempt 2/3)",
   "hook": "finish_line.py",
   "cleanup": false,
   "event": {
    "hook_event_name": "Stop",
    "stop_hook_active": true
   },
   "expect": "block",
   "session": "red"
  },
  {
   "name": "Still red: block (attempt 3/3)",
   "hook": "finish_line.py",
   "cleanup": false,
   "event": {
    "hook_event_name": "Stop",
    "stop_hook_active": true
   },
   "expect": "block",
   "session": "red"
  },
  {
   "name": "Red a 4th time: let it stop, warn the human (stop rule)",
   "hook": "finish_line.py",
   "files": {
    "src/ledgerly/_hooktest_red.py": "def f() -> int:\n    try:\n        return 1\n    except:\n        return 2\n"
   },
   "event": {
    "hook_event_name": "Stop",
    "stop_hook_active": true
   },
   "expect": "pass",
   "session": "red"
  },
  {
   "name": "All green after the fix: allow",
   "hook": "finish_line.py",
   "files": {
    "src/ledgerly/_hooktest_green.py": "\"\"\"ok.\"\"\"\n\nVALUE = 1\n"
   },
   "event": {
    "hook_event_name": "Stop",
    "stop_hook_active": false
   },
   "expect": "pass",
   "session": "green"
  }
 ]
}