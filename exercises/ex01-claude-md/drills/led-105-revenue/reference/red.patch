new file mode 100644
index 0000000..6c55014
--- /dev/null
+++ b/src/ledgerly/api/routes_reports.py
@@ -0,0 +1,24 @@
+from __future__ import annotations
+
+import sqlite3
+from typing import Annotated
+
+from fastapi import APIRouter, Depends
+
+from ledgerly.api.deps import get_conn
+from ledgerly.services.invoices import list_invoices
+from ledgerly.services.reports import revenue_report
+
+router = APIRouter(prefix="/reports", tags=["reports"])
+Conn = Annotated[sqlite3.Connection, Depends(get_conn)]
+
+
+@router.get("/revenue")
+def revenue(conn: Conn, currency: str = "USD") -> dict[str, object]:
+    report = revenue_report(conn, currency)
+    count = sum(1 for i in list_invoices(conn) if i.status == "paid")
+    return {
+        "currency": currency,
+        "total_cents": int(round(report["currency_total"] * 100)),
+        "invoice_count": count,
+    }
