diff --git a/tests/test_installments.py b/tests/test_installments.py
new file mode 100644
index 0000000..a708906
--- /dev/null
+++ b/tests/test_installments.py
@@ -0,0 +1,39 @@
+import sqlite3
+
+import pytest
+
+from ledgerly.payments.money import Money
+from ledgerly.services import installments as svc_installments
+from ledgerly.services import invoices as svc
+
+
+def _hundred(conn: sqlite3.Connection) -> svc.Invoice:
+    lines = [svc.Line("Widget", 1, Money(10_000, "USD"))]
+    return svc.create_invoice(conn, "Acme", "USD", lines, vat_rate_bp=0)
+
+
+def test_hundred_in_three_splits_last_part_takes_remainder(conn: sqlite3.Connection) -> None:
+    invoice = _hundred(conn)
+    plan = svc_installments.installment_plan(conn, invoice.id, 3)
+    assert plan.installments == (
+        Money(3_333, "USD"),
+        Money(3_333, "USD"),
+        Money(3_334, "USD"),
+    )
+
+
+def test_installments_sum_to_invoice_total(conn: sqlite3.Connection) -> None:
+    invoice = _hundred(conn)
+    plan = svc_installments.installment_plan(conn, invoice.id, 7)
+    assert sum(m.cents for m in plan.installments) == invoice.total.cents
+
+
+def test_installment_count_below_one_rejected(conn: sqlite3.Connection) -> None:
+    invoice = _hundred(conn)
+    with pytest.raises(ValueError, match="at least 1"):
+        svc_installments.installment_plan(conn, invoice.id, 0)
+
+
+def test_installment_plan_unknown_invoice_raises(conn: sqlite3.Connection) -> None:
+    with pytest.raises(KeyError):
+        svc_installments.installment_plan(conn, 999, 3)
