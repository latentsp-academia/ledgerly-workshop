diff --git a/src/ledgerly/api/routes_reports.py b/src/ledgerly/api/routes_reports.py
new file mode 100644
index 0000000..4928aa3
--- /dev/null
+++ b/src/ledgerly/api/routes_reports.py
@@ -0,0 +1,29 @@
+from __future__ import annotations
+
+import sqlite3
+from typing import Annotated
+
+from fastapi import APIRouter, Depends
+from pydantic import BaseModel
+
+from ledgerly.api.deps import get_conn
+from ledgerly.services.revenue import revenue
+
+router = APIRouter(prefix="/reports", tags=["reports"])
+Conn = Annotated[sqlite3.Connection, Depends(get_conn)]
+
+
+class RevenueOut(BaseModel):
+    currency: str
+    total_cents: int
+    invoice_count: int
+
+
+@router.get("/revenue", response_model=RevenueOut)
+def get_revenue(conn: Conn, currency: str = "USD") -> RevenueOut:
+    result = revenue(conn, currency)
+    return RevenueOut(
+        currency=result.total.currency,
+        total_cents=result.total.cents,
+        invoice_count=result.invoice_count,
+    )
diff --git a/src/ledgerly/services/revenue.py b/src/ledgerly/services/revenue.py
new file mode 100644
index 0000000..a744d0a
--- /dev/null
+++ b/src/ledgerly/services/revenue.py
@@ -0,0 +1,26 @@
+"""Revenue on integer cents (ADR-0001). Replaces services/reports.py for new callers."""
+
+from __future__ import annotations
+
+import sqlite3
+from dataclasses import dataclass
+
+from ledgerly.payments.fx import convert
+from ledgerly.payments.money import Money
+from ledgerly.services.invoices import list_invoices
+
+
+@dataclass(frozen=True)
+class Revenue:
+    total: Money
+    invoice_count: int
+
+
+def revenue(conn: sqlite3.Connection, currency: str = "USD") -> Revenue:
+    total = Money.zero(currency)
+    count = 0
+    for inv in list_invoices(conn):
+        if inv.status == "paid":
+            total = total + convert(inv.captured, currency)
+            count += 1
+    return Revenue(total=total, invoice_count=count)
