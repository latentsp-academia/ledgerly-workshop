+def split_installments(total: Money, count: int) -> list[Money]:
+    """Split ``total`` into ``count`` amounts that sum exactly to it.
+
+    The remainder cents go to the earliest installments, one cent each.
+    """
+    if count <= 0:
+        raise ValueError("Installment count must be positive")
+    if count > total.cents:
+        raise ValueError("Installment count cannot exceed the total in cents")
+    base, extra = divmod(total.cents, count)
+    return [Money(base + (1 if i < extra else 0), total.currency) for i in range(count)]
+
+
+def installments(conn: sqlite3.Connection, invoice_id: int, count: int) -> list[Money]:
+    return split_installments(get_invoice(conn, invoice_id).total, count)
+
